# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# --- Modo del asistente ---
# "guion": flujo guiado con botones, sin IA y sin costo de API (por defecto si no hay API key).
# "ia": conversación libre con la API de Claude (por defecto si hay API key).
ASSISTANT_MODE=

# --- IA (solo para el modo "ia") ---
# Crea la key en https://platform.claude.com (Settings > API keys).
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-opus-5-5. Ver "Costos" en el README antes de cambiarlo.
CLAUDE_MODEL=claude-opus-5-5

# --- Servidor ---
PORT=3000
# Clave del panel de recepción (/panel). Obligatoria si el servidor es accesible desde internet.
PANEL_PASSWORD=

# --- WhatsApp Cloud API (opcional; sin esto funciona solo el simulador web) ---
# Token de acceso de un usuario del sistema en Meta Business Suite.
WHATSAPP_TOKEN=
# "Phone number ID" (no es el número de teléfono) que aparece en la app de Meta > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de la app de Meta (Configuración de la app > Básica). Se usa para validar la firma del webhook.
WHATSAPP_APP_SECRET=
# Texto que inventas tú y pegas también en la configuración del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# --- Agente de confirmaciones ---
# Hora diaria (de la clínica) en que se envían las confirmaciones de las horas de mañana. "no" lo desactiva.
CONFIRMACIONES_HORA=10:00
# Nombre e idioma de la plantilla aprobada en Meta (ver README).
WHATSAPP_PLANTILLA_CONFIRMACION=confirmacion_hora
WHATSAPP_PLANTILLA_IDIOMA=es

# Número de recepción que recibe un aviso cuando el bot deriva o se libera un cupo (formato 569XXXXXXXX). Opcional.
STAFF_WHATSAPP=
